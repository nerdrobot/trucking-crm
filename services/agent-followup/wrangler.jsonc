{
  "name": "trucking-crm-followup",
  "main": "src/main.py",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-followup-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
